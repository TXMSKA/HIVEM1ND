{
  "id": "opencode",
  "displayName": "OpenCode",
  "detect": {
    "homePaths": [".config/opencode"],
    "binaries": ["opencode"]
  },
  "skills": {
    "homePath": ".agents/skills",
    "extension": ".md",
    "layout": "folder",
    "fileName": "SKILL.md",
    "frontmatterKeys": ["name", "description", "license", "compatibility", "metadata"]
  },
  "rules": {
    "homePath": ".config/opencode/AGENTS.md",
    "mode": "append"
  },
  "cli": {
    "binary": "opencode",
    "oneShot": ["run", "{prompt}"]
  },
  "readOnly": {
    "mode": "prompt",
    "oneShotArgs": []
  }
}
